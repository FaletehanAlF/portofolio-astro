---
/**
 * LogoLoop — port vanilla JS dari React Bits (reactbits.dev/components/logoloop).
 *
 * - Lapisan React dihapus; engine animasi ada di ./logoloop/logoloop-core.js.
 * - DOM-nya dibangun oleh JS, jadi CSS-nya dibuat global (semua selector
 *   ber-prefix `.logoloop`, tidak ada yang bocor ke elemen lain).
 * - Core di-import dinamis setelah halaman selesai load supaya JS awal kecil.
 *
 * Item logo menerima salah satu dari:
 * - { path, viewBox }  → ikon SVG 24×24 (mis. Simple Icons), diwarnai currentColor
 * - { src, alt }       → gambar
 * - { html }           → markup bebas
 * Plus opsional: title (label/tooltip), href, hoverColor, ariaLabel.
 */
interface LogoItem {
  /** `d` attribute SVG (mis. dari simpleicons.org). */
  path?: string;
  viewBox?: string;
  /** Markup SVG/HTML bebas — dipakai kalau `path` tidak diisi. */
  html?: string;
  src?: string;
  srcSet?: string;
  sizes?: string;
  width?: number;
  height?: number;
  alt?: string;
  title?: string;
  href?: string;
  hoverColor?: string;
  ariaLabel?: string;
}

interface Props {
  logos: LogoItem[];
  speed?: number;
  direction?: 'left' | 'right' | 'up' | 'down';
  width?: number | string;
  logoHeight?: number;
  gap?: number;
  pauseOnHover?: boolean;
  hoverSpeed?: number;
  fadeOut?: boolean;
  fadeOutWidth?: number;
  scaleOnHover?: boolean;
  layout?: 'line' | 'wave' | 'arc' | 'orbit';
  bend?: number;
  focus?: number;
  magnify?: number;
  tiltX?: number;
  tiltY?: number;
  step?: boolean;
  muted?: number;
  labels?: 'none' | 'inline' | 'below' | 'hover';
  draggable?: boolean;
  scrollBoost?: number;
  intro?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  logos,
  speed,
  direction,
  width,
  logoHeight,
  gap,
  pauseOnHover,
  hoverSpeed,
  fadeOut,
  fadeOutWidth,
  scaleOnHover,
  layout,
  bend,
  focus,
  magnify,
  tiltX,
  tiltY,
  step,
  muted,
  labels,
  draggable,
  scrollBoost,
  intro,
  ariaLabel,
  class: className
} = Astro.props;

// Hanya opsi yang dikenal yang diteruskan (prop internal Astro tidak ikut).
const options = {
  logos,
  speed,
  direction,
  width,
  logoHeight,
  gap,
  pauseOnHover,
  hoverSpeed,
  fadeOut,
  fadeOutWidth,
  scaleOnHover,
  layout,
  bend,
  focus,
  magnify,
  tiltX,
  tiltY,
  step,
  muted,
  labels,
  draggable,
  scrollBoost,
  intro,
  ariaLabel,
  className
};
---

<div class="logoloop-slot" data-logoloop data-options={JSON.stringify(options)}></div>

<style is:global>
  .logoloop {
    --logoloop-gap: 32px;
    --logoloop-logoHeight: 28px;
    --logoloop-pad: 0px;
    position: relative;
    overflow: hidden;
    overflow: clip;
    padding-top: var(--logoloop-pad);
    padding-bottom: var(--logoloop-pad);
    -webkit-tap-highlight-color: transparent;
  }

  .logoloop--vertical {
    display: inline-block;
    height: 100%;
    padding: 0 var(--logoloop-pad);
  }

  .logoloop[data-draggable] {
    cursor: grab;
    touch-action: pan-y pinch-zoom;
  }

  .logoloop--vertical[data-draggable] {
    touch-action: pan-x pinch-zoom;
  }

  .logoloop[data-dragging],
  .logoloop[data-dragging] * {
    cursor: grabbing;
  }

  .logoloop__track {
    position: relative;
    z-index: 0;
    display: flex;
    width: max-content;
    will-change: transform;
    user-select: none;
    -webkit-user-select: none;
  }

  .logoloop--vertical .logoloop__track {
    flex-direction: column;
    width: 100%;
    height: max-content;
  }

  .logoloop__list {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logoloop--vertical .logoloop__list {
    flex-direction: column;
  }

  .logoloop__item {
    position: relative;
    flex: 0 0 auto;
    margin-right: var(--logoloop-gap);
    font-size: var(--logoloop-logoHeight);
    line-height: 1;
  }

  .logoloop--vertical .logoloop__item {
    margin-right: 0;
    margin-bottom: var(--logoloop-gap);
  }

  .logoloop[data-intro] .logoloop__item {
    opacity: 0;
  }

  .logoloop__content {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logoloop-logoHeight) * 0.3);
    border-radius: 4px;
    color: inherit;
    text-decoration: none;
    transition:
      opacity 0.35s ease,
      filter 0.35s ease,
      color 0.35s ease;
  }

  .logoloop[data-labels='below'] .logoloop__content {
    flex-direction: column;
    gap: calc(var(--logoloop-logoHeight) * 0.22);
  }

  .logoloop__content:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .logoloop__node {
    display: inline-flex;
    align-items: center;
  }

  .logoloop__node svg {
    display: block;
  }

  .logoloop__item img {
    display: block;
    width: auto;
    height: var(--logoloop-logoHeight);
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .logoloop__node,
  .logoloop__item img {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .logoloop--scale-hover .logoloop__item:hover img,
  .logoloop--scale-hover .logoloop__item:hover .logoloop__node {
    transform: scale(1.2);
  }

  .logoloop__label {
    font-size: max(12px, calc(var(--logoloop-logoHeight) * 0.5));
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .logoloop[data-labels='below'] .logoloop__label {
    font-size: max(11px, calc(var(--logoloop-logoHeight) * 0.26));
    font-weight: 500;
    letter-spacing: 0;
    opacity: 0.72;
  }

  .logoloop__tip {
    position: absolute;
    top: 100%;
    left: 50%;
    margin-top: calc(var(--logoloop-logoHeight) * 0.2);
    font-size: max(11px, calc(var(--logoloop-logoHeight) * 0.26));
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    translate: -50% 4px;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      translate 0.25s ease;
  }

  .logoloop--vertical .logoloop__tip {
    top: 50%;
    left: 100%;
    margin-top: 0;
    margin-left: calc(var(--logoloop-logoHeight) * 0.25);
    translate: 4px -50%;
  }

  .logoloop__item:hover .logoloop__tip,
  .logoloop__item:focus-within .logoloop__tip,
  .logoloop__item[data-active] .logoloop__tip {
    opacity: 0.8;
    translate: -50% 0;
  }

  .logoloop--vertical .logoloop__item:hover .logoloop__tip,
  .logoloop--vertical .logoloop__item:focus-within .logoloop__tip,
  .logoloop--vertical .logoloop__item[data-active] .logoloop__tip {
    translate: 0 -50%;
  }

  .logoloop[data-muted] .logoloop__content {
    filter: grayscale(var(--logoloop-gray, 1));
    opacity: var(--logoloop-dim, 0.5);
  }

  .logoloop[data-muted] .logoloop__item:hover .logoloop__content,
  .logoloop[data-muted] .logoloop__item:focus-within .logoloop__content,
  .logoloop[data-muted] .logoloop__item[data-active] .logoloop__content {
    filter: none;
    opacity: 1;
  }

  .logoloop__item[data-color]:hover .logoloop__content,
  .logoloop__item[data-color]:focus-within .logoloop__content,
  .logoloop__item[data-color][data-active] .logoloop__content {
    color: var(--logoloop-item-color);
  }

  .logoloop:not([data-muted]) .logoloop__item:not([data-color]) a.logoloop__content:hover {
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .logoloop__content,
    .logoloop__node,
    .logoloop__item img,
    .logoloop__tip {
      transition: none;
    }
  }
</style>

<script>
  const bootLoops = async () => {
    const nodes = [...document.querySelectorAll('[data-logoloop]:not([data-logoloop-init])')].filter(
      (element) => element instanceof HTMLElement && element.offsetParent !== null && element.clientWidth > 0
    );
    if (!nodes.length) return;
    const { createLogoLoop } = await import('./logoloop/logoloop-core.js');
    nodes.forEach((element) => {
      element.setAttribute('data-logoloop-init', 'true');
      let options = {};
      try {
        options = JSON.parse(element.dataset.options || '{}');
      } catch {
        options = {};
      }
      createLogoLoop(element, options);
    });
  };

  const scheduleBoot = () => {
    if ('requestIdleCallback' in window) window.requestIdleCallback(bootLoops, { timeout: 1500 });
    else window.setTimeout(bootLoops, 200);
  };

  if (document.readyState === 'complete') scheduleBoot();
  else window.addEventListener('load', scheduleBoot, { once: true });
</script>
