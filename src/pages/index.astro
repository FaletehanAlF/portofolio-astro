
---
import "../styles/global.css";
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Portfolio Faletehan Al Farabi, Software Engineering Student dan Web Developer."
    />
    <title>Faletehan Al Farabi — Portfolio</title>
  </head>

  <body class="bg-[#f8f8f5] text-[#24241f]">
    <header class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 md:px-10">
      <a href="/" class="text-sm font-bold tracking-tight">
        FA<span class="text-[#77796b]">.</span>
      </a>

      <nav class="flex items-center gap-5 text-sm text-[#66665f] md:gap-8">
        <a href="/" class="text-[#24241f]">Home</a>
        <a href="/about" class="transition-colors hover:text-black">About</a>
        <a href="/projects" class="transition-colors hover:text-black">Projects</a>
        <a href="/contact" class="transition-colors hover:text-black">Contact</a>
      </nav>
    </header>

    <main>
      <section class="mx-auto grid max-w-7xl items-center gap-12 px-6 pb-24 pt-20 md:grid-cols-[1.3fr_0.7fr] md:px-10 md:pb-36 md:pt-28">
        <div>
          <p class="mb-7 flex items-center gap-3 text-xs font-medium uppercase tracking-[0.2em] text-[#77796b]">
            <span class="h-px w-8 bg-[#77796b]"></span>
            Software Engineering Student
          </p>

          <h1 class="max-w-3xl text-5xl font-semibold leading-[1.08] tracking-[-0.06em] sm:text-6xl md:text-7xl lg:text-8xl">
            Building digital
            <span class="font-normal italic text-[#77796b]">experiences</span>
            with purpose.
          </h1>

          <p class="mt-8 max-w-lg text-base leading-8 text-[#696960] md:text-lg">
            Halo, saya Faletehan Al Farabi. Saya tertarik pada software
            engineering dan pengembangan web untuk membangun solusi digital
            yang bermanfaat dan mudah digunakan.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-5">
            <a
              href="/projects"
              class="inline-flex items-center gap-3 bg-[#292a24] px-6 py-4 text-sm text-white transition-colors hover:bg-[#48493f]"
            >
              Lihat Proyek <span aria-hidden="true">↗</span>
            </a>

            <a
              href="/contact"
              class="text-sm underline decoration-[#b9b9ae] underline-offset-8 transition-colors hover:text-[#77796b]"
            >
              Hubungi Saya
            </a>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-sm md:justify-self-end">
          <div class="aspect-[4/5] overflow-hidden bg-[#e8e7df] p-5 sm:p-7">
            <div class="flex h-full flex-col justify-between border border-[#c9c8bd] p-5 sm:p-7">
              <span class="text-xs uppercase tracking-[0.2em] text-[#77796b]">
                Portfolio / 2026
              </span>

              <div>
                <p class="text-sm text-[#77796b]">Curious by nature.</p>
                <p class="mt-2 text-4xl font-medium tracking-[-0.06em] sm:text-5xl">
                  Made to<br />make an impact.
                </p>
              </div>

              <div class="flex items-end justify-between">
                <span class="text-xs text-[#77796b]">Based in Indonesia</span>
                <span class="text-3xl" aria-hidden="true">✳</span>
              </div>
            </div>
          </div>

          <span class="absolute -bottom-5 -left-3 text-xs text-[#77796b] sm:-left-8">
            Personal portfolio — 01
          </span>
        </div>
      </section>

      <section class="border-y border-[#e5e4dc]">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-5 px-6 py-6 text-xs uppercase tracking-[0.16em] text-[#77796b] md:px-10">
          <span>Web Development</span>
          <span aria-hidden="true">✳</span>
          <span>Creative Problem Solving</span>
          <span aria-hidden="true">✳</span>
          <span>Continuous Learning</span>
        </div>
      </section>
    </main>

    <footer class="mx-auto flex max-w-7xl flex-wrap justify-between gap-3 px-6 py-7 text-xs text-[#77796b] md:px-10">
      <span>© 2026 Faletehan Al Farabi</span>
      <span>Designed with intention.</span>
    </footer>
  </body>
</html>
