
---
import "../styles/global.css";
import StaggeredMenu from "../components/StaggeredMenu.astro";
import Lanyard from "../components/Lanyard.astro";
import LogoLoop from "../components/LogoLoop.astro";
import { techLogos } from "../data/tech-logos.js";

const menuItems = [
  { label: "Home", link: "/" },
  { label: "About", link: "/about" },
  { label: "Projects", link: "/projects" },
  { label: "Contact", link: "/contact" }
];

// TODO: ganti link placeholder di bawah dengan akun Anda yang sebenarnya.
const menuSocials = [
  { label: "GitHub", link: "https://github.com/FaletehanAlF" },
  { label: "LinkedIn", link: "#" },
  { label: "Email", link: "#" }
];
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Portfolio Faletehan Al Farabi, Software Engineering Student dan Web Developer."
    />
    <title>Faletehan Al Farabi — Portfolio</title>

    <!-- Montserrat: preconnect + hanya weight yang dipakai (400/500/600/700) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!--
      Penanda JS aktif: konten bawah-lipatan baru disembunyikan (untuk animasi
      reveal) setelah baris ini jalan — tanpa JS konten tetap terlihat.
    -->
    <script is:inline>document.documentElement.classList.add('has-reveal');</script>
  </head>

  <body class="bg-[#f8f8f5] text-[#24241f]">
    <StaggeredMenu items={menuItems} socialItems={menuSocials} />

    <!-- Spacer setinggi header sebelumnya agar alur halaman tetap sama -->
    <div class="h-[68px]"></div>

    <main>
      <section
        aria-labelledby="hero-title"
        class="mx-auto grid max-w-7xl px-6 pb-24 pt-20 md:px-10 md:pb-36 md:pt-28 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-x-20"
      >
        <!-- Kolom kiri: konten utama -->
        <div>
          <p
            class="hero-reveal flex items-center gap-3 text-xs font-medium uppercase tracking-[0.2em] text-[#77796b]"
            style="--reveal-delay: 0ms"
          >
            <span class="h-px w-8 bg-[#555c48]" aria-hidden="true"></span>
            Software Engineering Student
          </p>

          <h1
            id="hero-title"
            class="hero-reveal mt-7 text-5xl font-bold leading-[1.02] tracking-[-0.035em] text-[#24241f] sm:text-6xl lg:text-7xl xl:text-8xl"
            style="--reveal-delay: 80ms"
          >
            Faletehan<br />
            <span class="font-normal">Al Farabi</span><span class="text-[#555c48]">.</span>
          </h1>

          <p
            class="hero-reveal mt-7 max-w-xl text-pretty text-base leading-7 text-[#696960] md:text-lg md:leading-8"
            style="--reveal-delay: 160ms"
          >
            Halo, saya Faletehan — mahasiswa software engineering yang tertarik
            pada pengembangan web. Saya suka membangun antarmuka yang bersih,
            cepat, dan mudah digunakan, sambil terus belajar lewat project dan
            eksplorasi hal-hal baru di dunia web.
          </p>

          <div class="hero-reveal mt-10 flex flex-wrap items-center gap-x-4 gap-y-3" style="--reveal-delay: 240ms">
            <a
              href="/projects"
              class="hero-cta group relative inline-flex h-12 items-center gap-3 overflow-hidden rounded-full bg-[#24241f] pl-6 pr-1.5 text-sm font-medium tracking-wide text-[#f8f8f5] transition-[background-color,box-shadow,translate] duration-300 ease-out hover:bg-[#2d2e26] motion-safe:hover:shadow-[0_18px_34px_-20px_rgba(36,36,31,0.9)]"
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute left-[-70%] top-0 h-full w-[45%] -skew-x-12 bg-gradient-to-r from-transparent via-white/20 to-transparent motion-safe:transition-[translate] motion-safe:duration-700 motion-safe:ease-out motion-safe:group-hover:translate-x-[340%]"
              ></span>
              Lihat Project
              <span
                aria-hidden="true"
                class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[#f8f8f5] text-[#24241f] transition-[translate] duration-300 ease-out motion-safe:group-hover:-translate-y-0.5 motion-safe:group-hover:translate-x-0.5"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-3.5 w-3.5"
                >
                  <path d="M7 17 17 7"></path>
                  <path d="M8 7h9v9"></path>
                </svg>
              </span>
            </a>

            <a
              href="/contact"
              class="hero-link group inline-flex h-12 items-center gap-2.5 rounded-full border border-[#24241f]/25 px-6 text-sm font-medium tracking-wide text-[#24241f] transition-[background-color,border-color,color,translate] duration-300 ease-out hover:border-[#24241f] hover:bg-[#24241f] hover:text-[#f8f8f5]"
            >
              Hubungi Saya
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-3.5 w-3.5 transition-[translate] duration-300 ease-out motion-safe:group-hover:translate-x-0.5"
              >
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </a>
          </div>
        </div>

        <!--
          Kolom kanan: Lanyard (React Bits) — port vanilla JS + three.js.
          - Hanya dimuat di desktop (lg+); di bawah lg tidak diinisialisasi
            sama sekali supaya mobile tetap ringan.
          - three.js masuk sebagai chunk dinamis setelah halaman selesai load,
            dan render berhenti sendiri saat kartu sudah tenang.
        -->
        <div class="hero-slot hero-reveal-right hidden lg:block lg:h-[26rem]" style="--reveal-delay: 200ms">
          <Lanyard cardColor="#24241f" strapColor="#555c48" breeze={0} />
        </div>
      </section>

      <!--
        Tech Stack: logo berjalan (LogoLoop — port vanilla JS dari React Bits).
        Judul di tengah; loop melambat/berhenti saat hover atau fokus, bisa
        di-drag, dan berhenti total di bawah prefers-reduced-motion.
      -->
      <section aria-labelledby="tech-stack-title" class="border-t border-[#e5e4dc]">
        <div class="mx-auto max-w-7xl px-6 pb-14 pt-12 md:px-10 md:pb-16 md:pt-14">
          <h2
            id="tech-stack-title"
            data-reveal="left"
            class="flex items-center justify-center gap-4 text-center text-xs font-semibold uppercase tracking-[0.3em] text-[#77796b]"
          >
            <span class="h-px w-8 bg-[#555c48]" aria-hidden="true"></span>
            Tech Stack
            <span class="h-px w-8 bg-[#555c48]" aria-hidden="true"></span>
          </h2>

          <div class="mt-10 md:mt-12" data-reveal="up" style="--reveal-delay: 90ms">
            <LogoLoop
              logos={techLogos}
              speed={55}
              logoHeight={40}
              gap={64}
              fadeOutWidth={0.15}
              muted={0.45}
              labels="hover"
              scaleOnHover
              ariaLabel="Tech stack yang saya gunakan"
            />
          </div>
        </div>
      </section>

      <!--
        About Me: ringkasan singkat di bawah Tech Stack. Isi hanya memakai
        info yang sudah ada (peran, fokus, stack) — tanpa data yang dikarang.
        Kolom kiri muncul dari kiri, daftar fakta dari kanan (sistem reveal).
      -->
      <section id="about" aria-labelledby="about-title" class="border-t border-[#e5e4dc]">
        <div
          class="mx-auto grid max-w-7xl gap-10 px-6 py-14 md:px-10 md:py-16 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.85fr)] lg:gap-x-20"
        >
          <div data-reveal="left">
            <p class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.2em] text-[#77796b]">
              <span class="h-px w-8 bg-[#555c48]" aria-hidden="true"></span>
              About Me
            </p>

            <h2
              id="about-title"
              class="mt-7 text-3xl font-bold leading-[1.05] tracking-[-0.03em] text-[#24241f] sm:text-4xl"
            >
              Tentang saya<span class="text-[#555c48]">.</span>
            </h2>

            <p class="mt-6 max-w-xl text-pretty text-base leading-7 text-[#696960] md:text-lg md:leading-8">
              Saya Faletehan Al Farabi, mahasiswa software engineering yang
              menikmati proses mengubah ide menjadi antarmuka web yang bersih,
              cepat, dan enak dipakai — dari merapikan struktur, memilih warna
              dan tipografi, sampai memastikan halaman terasa ringan saat dibuka.
            </p>

            <p class="mt-4 max-w-xl text-pretty text-base leading-7 text-[#696960] md:text-lg md:leading-8">
              Saya percaya cara terbaik belajar adalah dengan membangun: setiap
              project jadi kesempatan untuk mencoba hal baru, memperbaiki
              detail kecil, dan menulis kode yang lebih rapi dari sebelumnya.
            </p>
          </div>

          <div data-reveal="right" style="--reveal-delay: 90ms" class="lg:pt-1">
            <dl class="divide-y divide-[#e5e4dc] border-y border-[#e5e4dc]">
              <div class="grid grid-cols-1 gap-1.5 py-4 sm:grid-cols-[9rem_1fr] sm:gap-4">
                <dt class="text-xs font-medium uppercase tracking-[0.16em] text-[#77796b] sm:pt-0.5">Fokus</dt>
                <dd class="text-sm leading-6 text-[#24241f] md:text-base md:leading-7">
                  Pengembangan web &amp; antarmuka (UI) yang bersih dan cepat
                </dd>
              </div>
              <div class="grid grid-cols-1 gap-1.5 py-4 sm:grid-cols-[9rem_1fr] sm:gap-4">
                <dt class="text-xs font-medium uppercase tracking-[0.16em] text-[#77796b] sm:pt-0.5">Tech stack</dt>
                <dd class="text-sm leading-6 text-[#24241f] md:text-base md:leading-7">
                  Astro, Tailwind CSS, dan JavaScript
                </dd>
              </div>
              <div class="grid grid-cols-1 gap-1.5 py-4 sm:grid-cols-[9rem_1fr] sm:gap-4">
                <dt class="text-xs font-medium uppercase tracking-[0.16em] text-[#77796b] sm:pt-0.5">Sekarang</dt>
                <dd class="text-sm leading-6 text-[#24241f] md:text-base md:leading-7">
                  Membangun portfolio ini sambil terus belajar lewat project nyata
                </dd>
              </div>
              <div class="grid grid-cols-1 gap-1.5 py-4 sm:grid-cols-[9rem_1fr] sm:gap-4">
                <dt class="text-xs font-medium uppercase tracking-[0.16em] text-[#77796b] sm:pt-0.5">Terbuka untuk</dt>
                <dd class="text-sm leading-6 text-[#24241f] md:text-base md:leading-7">
                  Kolaborasi project, belajar bareng, atau diskusi seputar web
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <section class="border-y border-[#e5e4dc]">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-5 px-6 py-6 text-xs uppercase tracking-[0.16em] text-[#77796b] md:px-10">
          <span data-reveal="left">Web Development</span>
          <span data-reveal="up" style="--reveal-delay: 60ms" aria-hidden="true">✳</span>
          <span data-reveal="up" style="--reveal-delay: 110ms">Creative Problem Solving</span>
          <span data-reveal="up" style="--reveal-delay: 160ms" aria-hidden="true">✳</span>
          <span data-reveal="right" style="--reveal-delay: 210ms">Continuous Learning</span>
        </div>
      </section>
    </main>

    <footer class="mx-auto flex max-w-7xl flex-wrap justify-between gap-3 px-6 py-7 text-xs text-[#77796b] md:px-10">
      <span data-reveal="left">© 2026 Faletehan Al Farabi</span>
      <span data-reveal="right">Designed with intention.</span>
    </footer>

    <!--
      Reveal konten saat masuk viewport: sekali jalan per elemen, hanya
      opacity + translate (murah untuk compositor), hormati reduced-motion.
    -->
    <script>
      const revealTargets = [...document.querySelectorAll('[data-reveal]')];
      if (revealTargets.length) {
        const wantsMotion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!wantsMotion || typeof IntersectionObserver === 'undefined') {
          for (const target of revealTargets) target.classList.add('is-revealed');
        } else {
          const observer = new IntersectionObserver(
            entries => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            },
            { threshold: 0.05 }
          );
          for (const target of revealTargets) observer.observe(target);
        }
      }
    </script>
  </body>
</html>

<style>
  /* Animasi masuk hero: sekali saat load — kolom teks dari kiri, kolom
     Lanyard dari kanan; halus, bertahap, dan hanya opacity + translate. */
  .hero-reveal {
    animation: hero-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--reveal-delay, 0ms);
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      translate: -22px 0;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .hero-reveal-right {
    animation: hero-reveal-right 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--reveal-delay, 200ms);
  }

  @keyframes hero-reveal-right {
    from {
      opacity: 0;
      translate: 24px 0;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* Reveal saat masuk viewport (aktif hanya jika JS berjalan) */
  :global(html.has-reveal) [data-reveal] {
    opacity: 0;
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      translate 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  :global(html.has-reveal) [data-reveal='left'] {
    translate: -22px 0;
  }

  :global(html.has-reveal) [data-reveal='right'] {
    translate: 22px 0;
  }

  :global(html.has-reveal) [data-reveal='up'] {
    translate: 0 14px;
  }

  :global(html.has-reveal) [data-reveal].is-revealed {
    opacity: 1;
    translate: 0 0;
  }

  /* Focus ring untuk CTA hero */
  .hero-cta:focus-visible,
  .hero-link:focus-visible {
    outline: 2px solid #555c48;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal,
    .hero-reveal-right {
      animation: none;
    }

    :global(html.has-reveal) [data-reveal] {
      opacity: 1;
      translate: none;
      transition: none;
    }
  }
</style>
